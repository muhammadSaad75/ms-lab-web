# Every route is prerendered to <route>/index.html, so Apache serves pages directly (and 301s
# "/about" to "/about/"). Unknown URLs get the prerendered 404 page with a real 404 status.
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /
# Canonical host: force HTTPS and drop "www."
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://mslabs.online%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  # Always revalidate the HTML so browsers pick up new chunk hashes after a deploy
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed assets never change
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
